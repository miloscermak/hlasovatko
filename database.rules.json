{
  "rules": {
    "sessions": {
      "$code": {
        ".read": "auth != null",

        "//": "Session smí zakládat kdokoli přihlášený, ale musí se v ní hned podepsat jako lektor. Potom už do ní zapisuje jen on.",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",

        "participants": {
          "$uid": {
            "//": "Účastník zapisuje jen sám sebe.",
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40"
          }
        },

        "votes": {
          "$qid": {
            "$uid": {
              "//": "Hlas smí zapsat jen jeho majitel a jen do otevřené otázky.",
              ".write": "auth != null && $uid === auth.uid && root.child('sessions').child($code).child('questions').child($qid).child('state').val() === 'open'",
              ".validate": "newData.hasChildren(['value', 'at'])"
            }
          }
        }
      }
    }
  }
}
